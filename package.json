{
    "name": "creedava-website",
    "private": false,
    "version": "1.0.0",
    "type": "module",
    "description": "Professional virtual assistant services website for CreedaVA - Built with React, TypeScript, and Tailwind CSS",
    "author": "CreedaVA <info@creedava.com>",
    "license": "UNLICENSED",
    "homepage": "https://www.creedava.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/Wiickedawesome/CreedaVA.git"
    },
    "bugs": {
        "url": "https://github.com/Wiickedawesome/CreedaVA/issues"
    },
    "keywords": [
        "virtual-assistant",
        "creedava",
        "website",
        "react",
        "typescript",
        "vite",
        "tailwindcss"
    ],
    "scripts": {
        "dev": "vite",
        "dev:api": "cd api && func start",
        "dev:full": "concurrently \"npm run dev\" \"npm run dev:api\"",
        "kill": "fuser -k 5000/tcp",
        "build": "npm run build:app && npm run build:widget",
        "build:app": "tsc -b --noCheck && vite build",
        "build:production": "tsc -b --noCheck && vite build --mode production",
        "build:github-pages": "tsc -b --noCheck && vite build --mode github-pages",
        "build:widget": "vite build --config vite.widget.config.ts",
        "lint": "eslint .",
        "format": "bash scripts/format-code.sh",
        "cleanup": "bash scripts/cleanup-dependencies.sh",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "setup:db": "cd api && NODE_TLS_REJECT_UNAUTHORIZED=0 node create-containers.js",
        "start:cosmos": "bash scripts/start-cosmos-emulator.sh",
        "stop:cosmos": "bash scripts/stop-cosmos-emulator.sh",
        "smoke:auto": "bash scripts/run-smoke-with-emulator.sh",
        "audit": "node scripts/deep-audit.cjs",
        "audit:config": "bash scripts/audit-config.sh",
        "audit:all": "npm run audit:config && npm run audit"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.2.2",
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/colors": "^3.0.0",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-aspect-ratio": "^1.1.8",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-menubar": "^1.1.16",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.11",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-query": "^5.90.20",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "embla-carousel-react": "^8.6.0",
        "framer-motion": "^12.34.0",
        "i18next": "^25.8.4",
        "i18next-browser-languagedetector": "^8.2.0",
        "input-otp": "^1.4.2",
        "jose": "^6.1.3",
        "lucide-react": "^0.563.0",
        "marked": "^17.0.1",
        "next-themes": "^0.4.6",
        "react": "^19.2.4",
        "react-day-picker": "^9.13.2",
        "react-dom": "^19.2.4",
        "react-error-boundary": "^6.1.0",
        "react-hook-form": "^7.71.1",
        "react-i18next": "^16.5.4",
        "react-resizable-panels": "^4.6.2",
        "react-router-dom": "^7.13.0",
        "recharts": "^3.7.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.4",
        "@vitejs/plugin-react-swc": "^4.2.3",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.0",
        "globals": "^17.3.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.1.11",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.55.0",
        "vite": "^7.3.1"
    }
}

{
  "name": "creedava",
  "version": "1.0.1",
  "packageManager": "npm@11.12.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:prod": "node scripts/smoke-check.mjs",
    "sync:thumbnails": "node scripts/sync-blog-thumbnails.mjs",
    "sync:thumbnails:check": "node scripts/sync-blog-thumbnails.mjs --check",
    "audit:design": "node scripts/audit-design-system.mjs",
    "audit:design:live": "node scripts/audit-design-system.mjs --live",
    "audit:design:visual": "node scripts/audit-design-system.mjs --visual --strict",
    "smoke:emulator:e2e": "node scripts/run-emulator-smoke.mjs scripts/emulator-e2e-smoke.mjs",
    "smoke:emulator:functions-load": "node scripts/run-emulator-smoke.mjs scripts/emulator-functions-load-smoke.mjs",
    "smoke:emulator:security": "node scripts/run-emulator-smoke.mjs scripts/emulator-security-smoke.mjs",
    "repair:page-seo": "node scripts/repair-page-seo.mjs",
    "check:preflight": "npm run sync:thumbnails:check && npm run lint && npm run audit:design && npm test && npm run build && npm --prefix functions run build && npm run smoke:emulator:functions-load && npm run smoke:emulator:security && npm run smoke:emulator:e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@google/generative-ai": "^0.24.1",
    "d3-geo": "^3.1.1",
    "firebase": "^13.4.0",
    "firebase-admin": "^13.10.0",
    "jose": "^6.1.3",
    "next": "^16.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "firebase-admin": {
      "@google-cloud/firestore": "8.5.0"
    },
    "@firebase/app": "0.16.7",
    "@google-cloud/storage": {
      "gaxios": "7.1.4",
      "retry-request": "8.0.2",
      "teeny-request": "10.1.2"
    },
    "google-gax": {
      "retry-request": "8.0.2"
    },
    "teeny-request": {
      "http-proxy-agent": "7.0.2"
    },
    "fast-xml-builder": "1.1.7",
    "fast-xml-parser": "5.12.0",
    "postcss": "8.5.26",
    "rimraf": "6.1.3",
    "uuid": "14.0.0",
    "@grpc/grpc-js": "1.14.7",
    "@fastify/busboy": "3.2.4",
    "node-forge": "1.4.3",
    "sharp": "0.35.5",
    "glob": "14.0.3",
    "source-map-js": "1.2.2",
    "baseline-browser-mapping": "2.11.34",
    "minimatch": "^11.0.1"
  }
}

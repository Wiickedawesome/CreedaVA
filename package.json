{
  "name": "creedava",
  "version": "1.0.1",
  "packageManager": "npm@11.12.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:prod": "node scripts/smoke-check.mjs",
    "smoke:emulator:e2e": "node scripts/run-emulator-smoke.mjs scripts/emulator-e2e-smoke.mjs",
    "smoke:emulator:functions-load": "node scripts/run-emulator-smoke.mjs scripts/emulator-functions-load-smoke.mjs",
    "smoke:emulator:security": "node scripts/run-emulator-smoke.mjs scripts/emulator-security-smoke.mjs",
    "check:preflight": "npm run lint && npm test && npm run build && npm --prefix functions run build && npm run smoke:emulator:functions-load && npm run smoke:emulator:security && npm run smoke:emulator:e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "d3-geo": "^3.1.1",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "jose": "^6.1.3",
    "next": "^16.2.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "firebase-admin": {
      "@google-cloud/firestore": "8.5.0"
    },
    "@google-cloud/storage": {
      "gaxios": "7.1.4",
      "retry-request": "8.0.2",
      "teeny-request": "10.1.2"
    },
    "google-gax": {
      "retry-request": "8.0.2"
    },
    "teeny-request": {
      "http-proxy-agent": "7.0.2"
    },
    "fast-xml-builder": "1.1.7",
    "postcss": "8.5.13",
    "rimraf": "6.1.2",
    "uuid": "14.0.0"
  }
}

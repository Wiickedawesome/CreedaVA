
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user belongs to CreedaVA domain
    // Uses email match instead of hd claim (hd only works with Google Workspace)
    function isAdmin() {
      return isAuth() && request.auth.token.email.matches('.*@creedava[.]com$');
    }

    // Blog posts — public read, admin write
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy contact-submissions collection (deprecated).
    // Canonical intake path is now Cloud Function -> /contacts.
    match /contact-submissions/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // CRM Contacts — admin only
    match /contacts/{contactId} {
      allow read, write: if isAdmin();
    }

    // Bookings — validated public create, admin can manage
    // Note: 'service' is a reserved keyword in rules — must use bracket notation.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'service'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data['service'] is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 320
                    && request.resource.data['service'].size() > 0
                    && request.resource.data['service'].size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // CRM entities — admin only
    match /leads/{docId} {
      allow read, write: if isAdmin();
    }
    match /customers/{docId} {
      allow read, write: if isAdmin();
    }
    match /tasks/{docId} {
      allow read, write: if isAdmin();
    }
    match /projects/{docId} {
      allow read, write: if isAdmin();
    }
    match /notes/{docId} {
      allow read, write: if isAdmin();
    }

    // SEO / keywords — admin only
    match /seo/{docId} {
      allow read, write: if isAdmin();
    }
    match /keywords/{docId} {
      allow read, write: if isAdmin();
    }

    // Settings — admin only
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Integrations — admin only
    match /integrations/{docId} {
      allow read, write: if isAdmin();
    }

    // Social posts — admin only
    match /social-posts/{docId} {
      allow read, write: if isAdmin();
    }

    // Email drafts — admin only
    match /emails/{docId} {
      allow read, write: if isAdmin();
    }

    // Inbox messages — admin only
    match /inbox/{docId} {
      allow read, write: if isAdmin();
    }

    // Email campaigns — admin only
    match /email-campaigns/{docId} {
      allow read, write: if isAdmin();
    }

    // Ad/marketing campaigns (Google Ads, Facebook Ads, media buys) — admin only.
    // DISTINCT from /email-campaigns: this collection stores ad campaign data
    // (budget, impressions, clicks, conversions) while /email-campaigns stores
    // email newsletter data. Both are managed on the Marketing → Campaigns page.
    match /campaigns/{docId} {
      allow read, write: if isAdmin();
    }

    // Landing pages — public read, admin write
    match /landing-pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Page SEO metadata — public read, admin write
    match /page-seo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI Reports — admin only
    match /reports/{docId} {
      allow read, write: if isAdmin();
    }

    // AI Worker tasks — admin only
    match /ai-tasks/{docId} {
      allow read, write: if isAdmin();
    }
    
    // AI Insights - admin only
    match /ai-insights/{docId} {
      allow read, write: if isAdmin();
    }

    // AI Activity Log — audit trail for autonomous AI actions (admin read-only, written by client SDK)
    match /ai-activity-log/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── SEO Agent (autonomous "living AI") ────────────
    // All written by Cloud Functions; admin can read + correct via dashboard.
    match /agent-runs/{docId}        { allow read, write: if isAdmin(); }
    match /seo-tasks/{docId}         { allow read, write: if isAdmin(); }
    match /rank-history/{docId}      { allow read, write: if isAdmin(); }
    match /onpage-audits/{docId}     { allow read, write: if isAdmin(); }
    match /keyword-gaps/{docId}      { allow read, write: if isAdmin(); }
    match /citation-audits/{docId}   { allow read, write: if isAdmin(); }
    match /backlink-prospects/{docId}        { allow read, write: if isAdmin(); }
    match /outreach-emails/{docId}            { allow read, write: if isAdmin(); }
    match /internal-link-suggestions/{docId}  { allow read, write: if isAdmin(); }
    match /content-briefs/{docId}             { allow read, write: if isAdmin(); }

    // AI Conversations — chat history for dashboard AI assistant
    match /ai-conversations/{docId} {
      allow read, write: if isAdmin();
    }

    // Analytics — validated public create, admin read
    // App Check (reCAPTCHA Enterprise) is the primary abuse-prevention layer.
    match /analytics/{docId} {
      allow create: if request.resource.data.keys().hasAny(['event', 'page', 'type'])
                    && (request.resource.data.get('event', '') is string)
                    && (request.resource.data.get('page', '') is string)
                    && request.resource.data.size() <= 15;
      allow read, update, delete: if isAdmin();
    }

    // Forum threads — public read, authenticated create, author/admin update
    match /forum/{threadId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Forum replies — public read, authenticated create, author/admin update
    match /forumReplies/{replyId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Forum user profiles — public read (display names), authenticated create/update own
    match /forumProfiles/{profileId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Satisfaction survey tokens — public read (token UUID is the auth),
    // admin create, submissions handled by Cloud Function
    match /satisfaction-tokens/{tokenId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

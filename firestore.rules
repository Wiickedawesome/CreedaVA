rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user belongs to CreedaVA domain
    // Uses email match instead of hd claim (hd only works with Google Workspace)
    function isAdmin() {
      return isAuth() && request.auth.token.email.matches('.*@creedava[.]com$');
    }

    // Blog posts — public read, admin write
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form submissions from website — public create, admin read
    match /contact-submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // CRM Contacts — admin only
    match /contacts/{contactId} {
      allow read, write: if isAdmin();
    }

    // Bookings — anyone can create, admin can manage
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // CRM entities — admin only
    match /leads/{docId} {
      allow read, write: if isAdmin();
    }
    match /customers/{docId} {
      allow read, write: if isAdmin();
    }
    match /tasks/{docId} {
      allow read, write: if isAdmin();
    }
    match /projects/{docId} {
      allow read, write: if isAdmin();
    }
    match /notes/{docId} {
      allow read, write: if isAdmin();
    }

    // SEO / keywords — admin only
    match /seo/{docId} {
      allow read, write: if isAdmin();
    }
    match /keywords/{docId} {
      allow read, write: if isAdmin();
    }

    // Settings — admin only
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Integrations — admin only
    match /integrations/{docId} {
      allow read, write: if isAdmin();
    }

    // Social posts — admin only
    match /social-posts/{docId} {
      allow read, write: if isAdmin();
    }

    // Email drafts — admin only
    match /emails/{docId} {
      allow read, write: if isAdmin();
    }

    // Campaigns — admin only
    match /campaigns/{docId} {
      allow read, write: if isAdmin();
    }

    // Landing pages — public read, admin write
    match /landing-pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Page SEO metadata — public read, admin write
    match /page-seo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI Reports — admin only
    match /reports/{docId} {
      allow read, write: if isAdmin();
    }

    // AI Worker tasks — admin only
    match /ai-tasks/{docId} {
      allow read, write: if isAdmin();
    }

    // Analytics — public create, admin read
    match /analytics/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Forum threads — public read, authenticated create, admin manage
    match /forum/{threadId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() || isAdmin();
      allow delete: if isAdmin();
    }

    // Forum replies — public read, authenticated create, admin manage
    match /forumReplies/{replyId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() || isAdmin();
      allow delete: if isAdmin();
    }

    // Forum user profiles — public read (display names), authenticated create/update own
    match /forumProfiles/{profileId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

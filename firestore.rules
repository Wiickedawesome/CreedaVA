
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user belongs to CreedaVA domain
    // Uses email match instead of hd claim (hd only works with Google Workspace)
    //
    // email_verified is REQUIRED. Without it, any account whose address merely
    // *claims* @creedava.com is an admin. Google sign-in always sets this true,
    // so the only thing this blocks is a self-registered, unverified address
    // (email/password sign-up lets a user type whatever address they like).
    // email != null guards providers that issue tokens without an email claim.
    function isAdmin() {
      return isAuth()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@creedava[.]com$');
    }

    // ─── Forum helpers ────────────────────────────────
    // Two narrow update paths belong to readers, not authors:
    //   - reacting, which writes only `likes` / `likedBy`;
    //   - on-demand translation, which writes only `lang` / `translations`
    //     (see `ensureThreadTranslated`, invoked from the public list page).
    function reactionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']);
    }
    function translationOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lang', 'translations']);
    }
    /** An author edit must not hand the document to a different account. */
    function keepsAuthor() {
      return request.resource.data.authorId == resource.data.authorId;
    }

    // Blog posts — public read, admin write
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy contact-submissions collection (deprecated).
    // Canonical intake path is now Cloud Function -> /contacts.
    match /contact-submissions/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // CRM Contacts — admin only
    match /contacts/{contactId} {
      allow read, write: if isAdmin();
    }

    // Bookings — validated public create, admin can manage
    // Note: 'service' is a reserved keyword in rules — must use bracket notation.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'service'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data['service'] is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 320
                    && request.resource.data['service'].size() > 0
                    && request.resource.data['service'].size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // CRM entities — admin only
    match /leads/{docId} {
      allow read, write: if isAdmin();
    }
    match /customers/{docId} {
      allow read, write: if isAdmin();
    }
    match /tasks/{docId} {
      allow read, write: if isAdmin();
    }
    match /projects/{docId} {
      allow read, write: if isAdmin();
    }
    match /notes/{docId} {
      allow read, write: if isAdmin();
    }

    // SEO / keywords — admin only
    match /seo/{docId} {
      allow read, write: if isAdmin();
    }
    match /keywords/{docId} {
      allow read, write: if isAdmin();
    }

    // Settings — admin only
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Integrations — admin only
    match /integrations/{docId} {
      allow read, write: if isAdmin();
    }

    // Email drafts — admin only
    match /emails/{docId} {
      allow read, write: if isAdmin();
    }

    // Inbox messages — admin only
    match /inbox/{docId} {
      allow read, write: if isAdmin();
    }

    // Email campaigns — admin only
    match /email-campaigns/{docId} {
      allow read, write: if isAdmin();
    }

    // Ad/marketing campaigns (Google Ads, Facebook Ads, media buys) — admin only.
    // DISTINCT from /email-campaigns: this collection stores ad campaign data
    // (budget, impressions, clicks, conversions) while /email-campaigns stores
    // email newsletter data. Both are managed on the Marketing → Campaigns page.
    match /campaigns/{docId} {
      allow read, write: if isAdmin();
    }

    // Landing pages — public read, admin write
    match /landing-pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Page SEO metadata — public read, admin write
    match /page-seo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI Reports — admin only
    match /reports/{docId} {
      allow read, write: if isAdmin();
    }

    // AI Worker tasks — admin only
    match /ai-tasks/{docId} {
      allow read, write: if isAdmin();
    }
    
    // AI Insights - admin only
    match /ai-insights/{docId} {
      allow read, write: if isAdmin();
    }

    // AI Activity Log — audit trail for autonomous AI actions (admin read-only, written by client SDK)
    match /ai-activity-log/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── SEO Agent (autonomous "living AI") ────────────
    // All written by Cloud Functions; admin can read + correct via dashboard.
    match /agent-runs/{docId}        { allow read, write: if isAdmin(); }
    // Findings: skills write them, the admin Fix/Ignore buttons update status.
    match /findings/{docId}          { allow read, write: if isAdmin(); }
    // Legacy task board — abandoned, kept only so old docs stay readable.
    match /seo-tasks/{docId}         { allow read, write: if isAdmin(); }
    match /rank-history/{docId}      { allow read, write: if isAdmin(); }
    match /onpage-audits/{docId}     { allow read, write: if isAdmin(); }
    match /keyword-gaps/{docId}      { allow read, write: if isAdmin(); }
    match /citation-audits/{docId}   { allow read, write: if isAdmin(); }
    match /backlink-prospects/{docId}        { allow read, write: if isAdmin(); }
    match /outreach-emails/{docId}            { allow read, write: if isAdmin(); }
    match /internal-link-suggestions/{docId}  { allow read, write: if isAdmin(); }
    match /content-briefs/{docId}             { allow read, write: if isAdmin(); }

    // Daily Google sync log — admin only (written by Cloud Function admin SDK).
    match /sync-log/{docId}                   { allow read, write: if isAdmin(); }

    // Google Business reviews cache — admin only (written by Cloud Function).
    match /business-reviews/{docId}           { allow read, write: if isAdmin(); }

    // AI Conversations — chat history for dashboard AI assistant
    match /ai-conversations/{docId} {
      allow read, write: if isAdmin();
    }

    // Analytics — validated public create, admin read
    // App Check (reCAPTCHA Enterprise) is the primary abuse-prevention layer.
    //
    // The shape check names the fields the app actually writes. It previously
    // tested `hasAny(['event','page','type'])` and then read `event`, but
    // `trackEvent` writes `eventType` — so the only thing the rule really
    // verified was that `page` existed. Every write path goes through
    // `trackEvent`, so `eventType` + `page` is exact rather than approximate.
    match /analytics/{docId} {
      allow create: if request.resource.data.keys().hasAll(['eventType', 'page'])
                    && request.resource.data.eventType is string
                    && request.resource.data.eventType.size() > 0
                    && request.resource.data.eventType.size() <= 64
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 512
                    && request.resource.data.size() <= 15;
      allow read, update, delete: if isAdmin();
    }

    // Forum threads — public read, authenticated create, author/admin update.
    //
    // The authorship field is `authorId`. These rules previously compared
    // `resource.data.uid`, which does not exist on a forum document, so two
    // things were true in production: an author could never edit their own post
    // (the comparison silently denied), and `create` did not bind the author to
    // the caller at all, so any signed-in user could post under another user's
    // id. Helpers live with the other functions at the top of this file.
    match /forum/{threadId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 20000;
      allow update: if isAdmin()
                    || (isAuth() && resource.data.authorId == request.auth.uid && keepsAuthor())
                    || (isAuth() && (reactionOnly() || translationOnly()));
      allow delete: if isAdmin();
    }

    // Forum replies — same shape as threads.
    match /forumReplies/{replyId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 20000;
      allow update: if isAdmin()
                    || (isAuth() && resource.data.authorId == request.auth.uid && keepsAuthor())
                    || (isAuth() && (reactionOnly() || translationOnly()));
      allow delete: if isAdmin();
    }

    // Forum user profiles — public read (display names), owner-only writes.
    // `uid` is the ownership field here (unlike threads/replies, which use
    // `authorId`). Create must bind it to the caller and update must not allow it
    // to be reassigned, otherwise a profile could be handed to another account.
    match /forumProfiles/{profileId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuth()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    // Satisfaction survey tokens.
    //
    // `get` is public because the UUID in the link is the bearer credential.
    // `list` is admin-only: allowing it let anyone enumerate every outstanding
    // token and submit surveys that were never issued to them. The previous
    // single `read` rule granted both.
    match /satisfaction-tokens/{tokenId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

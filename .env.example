# CreedaVA Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# GOOGLE OAUTH (Required for Admin Login)
# ============================================
# Get this from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
VITE_GOOGLE_CLIENT_ID=848560364888-odta7t8v7e7s70rtjojn7fapm5pbukqu.apps.googleusercontent.com
VITE_ENABLE_GOOGLE_LOGIN=true

# ============================================
# GOOGLE ANALYTICS (Optional but Recommended)
# ============================================
# Get this from: Google Analytics → Admin → Data Streams → Web Stream Details
VITE_GA_MEASUREMENT_ID=G-0EPSFYFWZQ

# ============================================
# API CONFIGURATION
# ============================================
# Local development: /api
# Production: Leave as /api or set to your Azure Functions URL
VITE_API_BASE_URL=/api

# ============================================
# BASE PATH (Deployment)
# ============================================
# For GitHub Pages: /CreedaVA/
# For custom domain or Azure: /
# VITE_BASE_PATH=/

# ============================================
# DEVELOPMENT MODE (Optional)
# ============================================
# Set to 'true' to enable dev-mode login (no real OAuth)
# NEVER set this in production!
# VITE_DEV_MODE=false

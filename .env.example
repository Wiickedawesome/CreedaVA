# Environment Variables

# Azure Functions API (for LinkedIn integration and data)
VITE_API_URL=/api

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Azure Cosmos DB Configuration (for analytics and contact data)
VITE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
VITE_COSMOS_KEY=your_cosmos_key

# Azure Functions API Base URL
VITE_API_BASE_URL=/api

# Google Search Console API
VITE_GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_SEARCH_CONSOLE_API_KEY=your_google_api_key

# Application
VITE_APP_URL=https://www.creedava.com

# Build Configuration (use / for Azure, /CreedaVA/ for GitHub Pages)
VITE_BASE_PATH=/

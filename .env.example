# Environment Variables

# Azure Functions API (for LinkedIn integration and data)
VITE_API_URL=/api

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Entra ID (Azure AD) authentication
VITE_AAD_CLIENT_ID=77207644-cbca-4d8f-b6f0-a9b077ba0f46
VITE_AAD_TENANT_ID=9c523818-9203-4d2e-a5c6-d401fa753fd5
# Optional: override authority if needed
# VITE_AAD_AUTHORITY=https://login.microsoftonline.com/9c523818-9203-4d2e-a5c6-d401fa753fd5/v2.0

# Azure Functions API Base URL
VITE_API_BASE_URL=/api

# Google Search Console API
VITE_GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_SEARCH_CONSOLE_API_KEY=your_google_api_key

# Application
VITE_APP_URL=https://www.creedava.com

# Build Configuration (use / for Azure, /CreedaVA/ for GitHub Pages)
VITE_BASE_PATH=/

# ─── Firebase Web App Config ─────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
# These NEXT_PUBLIC_ values are intentionally exposed to the browser.
# Security is enforced by Firestore Rules, Auth domain restrictions,
# and API key restrictions in Google Cloud Console.

NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ─── Google Analytics ─────────────────────────────────────────────────────────
# Same as NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID for Firebase-hosted projects.
# Override only if using a separate GA4 property outside Firebase.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ─── Cloud Functions Base URL ─────────────────────────────────────────────────
# Your Cloud Functions HTTP endpoint base URL (match the region in functions/src/).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL="https://us-east4-your-project.cloudfunctions.net"

# ─── Optional: Firebase App Check (reCAPTCHA Enterprise) ─────────────────────
# Protects Firestore, Storage, and Cloud Functions from unauthorized access.
# Steps:
#   1. Enable App Check in Firebase Console → App Check
#   2. Register your site in Google Cloud Console → reCAPTCHA Enterprise
#   3. Copy the site key below
# Leave blank to disable App Check (not recommended for production).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# ─── Optional: Firebase Cloud Messaging (Push Notifications) ──────────────────
# Enables push notifications to admin users for new leads, bookings, forum posts.
# Steps:
#   1. Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
#   2. Generate a key pair and copy the public VAPID key below
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

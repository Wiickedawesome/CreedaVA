# API endpoint (use full URL in production)
VITE_API_BASE_URL=https://creedava.com/api

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-0EPSFYFWZQ

# Google OAuth (copy from .env)
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_GOOGLE_CLIENT_ID=274483123238-bqcgilmp2nl2hutjv4u7hf4f49pbftpe.apps.googleusercontent.com

# Development mode (disabled in production)
VITE_DEV_MODE=false

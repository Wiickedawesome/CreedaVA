# ─── CreedaVA Cloud Functions — Integration Environment Variables ──────────────
#
# These serve as a HARDCODED FALLBACK when Firestore integration configs are
# missing or can't be read. Firestore values take precedence when available.
#
# Copy to .env (in the functions/ directory) and fill in values:
#   cp .env.example .env
#
# Or use Firebase Secrets for sensitive values:
#   firebase functions:secrets:set SMTP_PASS
#
# ──────────────────────────────────────────────────────────────────────────────

# ─── Email (SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@creedava.com
SMTP_PASS=                          # 16-char Gmail App Password
SMTP_ALIASES=                       # Comma-separated: hello@creedava.com, team@creedava.com

# ─── Google Calendar ──────────────────────────────────
GCAL_CALENDAR_ID=admin@creedava.com
GCAL_SERVICE_ACCOUNT_EMAIL=
GCAL_SERVICE_ACCOUNT_KEY=           # Full JSON key (single line or escaped)

# ─── Google Ads ───────────────────────────────────────
GADS_DEVELOPER_TOKEN=
GADS_CLIENT_ID=                     # xxx.apps.googleusercontent.com
GADS_CLIENT_SECRET=
GADS_REFRESH_TOKEN=
GADS_CUSTOMER_ID=                   # Format: 123-456-7890

# ─── Search Console ──────────────────────────────────
GSC_SITE_URL=https://creedava.com
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_SERVICE_ACCOUNT_KEY=            # Full JSON key

# ─── Google Business Profile ─────────────────────────
GBP_ACCOUNT_ID=                     # accounts/123456789
GBP_LOCATION_ID=                    # locations/987654321
GBP_SERVICE_ACCOUNT_EMAIL=
GBP_SERVICE_ACCOUNT_KEY=            # Full JSON key

# ─── Google Analytics (GA4) ──────────────────────────
GA4_PROPERTY_ID=                    # properties/123456789
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_KEY=            # Full JSON key

# ─── Google Sheets ───────────────────────────────────
GSHEETS_SPREADSHEET_ID=             # Auto-created if blank
GSHEETS_SERVICE_ACCOUNT_EMAIL=
GSHEETS_SERVICE_ACCOUNT_KEY=        # Full JSON key

# ─── Google Drive ────────────────────────────────────
GDRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_EMAIL=
GDRIVE_SERVICE_ACCOUNT_KEY=         # Full JSON key

# ─── Web Search (Brave Search API) ───────────────────
BRAVE_SEARCH_API_KEY=             # https://api.search.brave.com/app/dashboard

# ─── Webhooks ────────────────────────────────────────
WEBHOOK_API_KEY=                    # Optional — secure your endpoint

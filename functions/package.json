{
  "name": "creedava-functions",
  "version": "1.0.0",
  "description": "CreedaVA Cloud Functions — email, calendar, ads, search console integrations",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@types/mailparser": "^3.4.6",
    "cors": "^2.8.5",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "googleapis": "^148.0.0",
    "imapflow": "^1.2.9",
    "mailparser": "^3.9.3",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/imapflow": "^1.0.23",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.0"
  },
  "private": true
}

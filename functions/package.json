{
  "name": "creedava-functions",
  "version": "1.0.1",
  "packageManager": "npm@11.12.1",
  "description": "CreedaVA Cloud Functions — email, calendar, ads, search console integrations",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24",
    "npm": "11.x"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5",
    "googleapis": "^171.4.0",
    "nodemailer": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^7.0.11",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "firebase-admin": {
      "@google-cloud/firestore": "8.5.0"
    },
    "@google-cloud/storage": {
      "gaxios": "7.1.4",
      "retry-request": "8.0.2",
      "teeny-request": "10.1.2"
    },
    "google-gax": {
      "retry-request": "8.0.2"
    },
    "teeny-request": {
      "http-proxy-agent": "7.0.2"
    },
    "fast-xml-builder": "1.1.7",
    "rimraf": "6.1.2",
    "ts-deepmerge": "8.0.0",
    "uuid": "14.0.0"
  },
  "private": true
}
